#include <windows.h>
#include "resource.h"
#include "../include/infclick/Version.h"

IDI_INFCLICK         ICON    "infclick.ico"
IDI_INFCLICK_ACTIVE  ICON    "infclick_active.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "infclick.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     INFCLICK_VER_MAJOR, INFCLICK_VER_MINOR, INFCLICK_VER_PATCH, 0
 PRODUCTVERSION  INFCLICK_VER_MAJOR, INFCLICK_VER_MINOR, INFCLICK_VER_PATCH, 0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Infinity Clicker project"
            VALUE "FileDescription",  "Infinity Clicker"
            VALUE "FileVersion",      INFCLICK_VERSION
            VALUE "InternalName",     "Infinity Clicker"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "InfinityClicker.exe"
            VALUE "ProductName",      "Infinity Clicker"
            VALUE "ProductVersion",   INFCLICK_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
